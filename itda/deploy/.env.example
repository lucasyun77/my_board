# 아이센스투게더 중계 서버 설정 파일 견본
# 사용법: 이 파일을 .env 로 복사한 뒤 아래 빈칸을 채웁니다.  cp .env.example .env
# 주의: .env 에는 비밀 값이 들어갑니다. 저장소에 올리거나 메신저로 보내지 마세요.

# [필수] 데이터베이스(포스트그레스) 암호. 길고 추측하기 어려운 글자로 정합니다.
POSTGRES_PASSWORD=

# [로그인] 회사 구글 클라우드에서 만든 「데스크톱 앱」 OAuth 클라이언트의 번호.
# 비워 두면 시험용(모임 암호) 로그인으로 켜집니다. 사내 시험 외에는 꼭 채우세요.
TOGETHER_GOOGLE_CLIENT_ID=

# [로그인] 같은 클라이언트의 비밀 값
TOGETHER_GOOGLE_CLIENT_SECRET=

# [로그인] 들어올 수 있는 회사 도메인. 여러 개면 쉼표로 구분합니다.
TOGETHER_ALLOWED_DOMAIN=

# [관리자] 계정 차단·감사 기록을 볼 수 있는 관리자 이메일. 여러 명이면 쉼표로 구분합니다.
TOGETHER_ADMINS=

# [선택] AI 본부장 클로드를 켜는 열쇠. 비우면 규칙으로만 답합니다.
ANTHROPIC_API_KEY=

# [선택] 구글 로그인을 쓰지 않는 시험 상태에서만 쓰는 모임 암호
ITDA_TEAM_KEY=

# [선택] 서버 바깥에 열어 줄 주소와 포트. 비우면 기본값(서버 안에서만 열림, 7878번).
# 캐디 앞단 없이 직접 열려면 RELAY_BIND=0.0.0.0 으로 바꿉니다.
RELAY_BIND=
RELAY_PORT=

# [캐디 앞단용] 회사 소유 도메인 이름. 그 이름이 이 서버를 가리키도록 먼저 설정해야 합니다.
TOGETHER_DOMAIN=
